// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  phone          String?        @unique
  oauthProvider  String?
  oauthId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  password       String
  role           Role           @default(USER)
  profile        Profile?
  following      Follow[]       @relation("follower")
  followers      Follow[]       @relation("following")
  posts          Post[]
  comments       Comment[]
  notifications  Notification[]
  eventsHosted   Event[]        @relation("EventHost")
  eventsAttended Attendee[]
  blogs          Blog[]         @relation("BlogAuthor")
}

model Profile {
  id              String   @id @default(cuid())
  userName        String
  bio             String?
  profilePublicId String?
  profileFormat   String?
  profileVersion  String?
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
  githubUrl       String?
  portfolioUrl    String?
  skills          String[]
  profileImageUrl String?  @default("https://wallpapers-clan.com/wp-content/uploads/2022/08/default-pfp-25.jpg") // Default profile image URL
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("follower", fields: [followerId], references: [id])
  followerId  String
  following   User     @relation("following", fields: [followingId], references: [id])
  followingId String
  createdAt   DateTime @default(now())
}

model Post {
  id          String     @id @default(cuid())
  title       String
  content     String?
  author      User       @relation(fields: [authorId], references: [id])
  authorId    String
  createdAt   DateTime   @default(now())
  type        PostType   @default(REGULAR)
  imageUrl    String?
  videoUrl    String?
  codeQuery   CodeQuery? @relation("PostToCodeQuery")
  codeQueryId String?    @unique
  updatedAt   DateTime   @updatedAt
  comments    Comment[]
  tags        String[]
  Claps       Int        @default(0)
}

model CodeQuery {
  id           Int      @id @default(autoincrement())
  relevantTech String[]
  errorDetails Json
  codeSnippet  String
  post         Post?    @relation("PostToCodeQuery", fields: [postId], references: [id])
  postId       String?  @unique
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  post      Post?    @relation(fields: [postId], references: [id])
  postId    String?
  blog      Blog?    @relation(fields: [blogId], references: [id])
  blogId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String
  date        DateTime
  time        DateTime
  location    String
  eventLink   String?
  host        User        @relation("EventHost", fields: [hostId], references: [id])
  hostId      String
  attendees   Attendee[]  @relation("EventAttendees") // Add relation name
  status      EventStatus @default(UPCOMING) // Change to enum type
  eventImage  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Attendee {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  event     Event    @relation("EventAttendees", fields: [eventId], references: [id])
  eventId   String
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Blog {
  id        String    @id @default(cuid())
  title     String
  content   String
  author    User      @relation("BlogAuthor", fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tags      String[]
  comments  Comment[]
  Claps     Int       @default(0)
  imageUrl  String?
  videoUrl  String?
}

enum Role {
  USER
  ADMIN
  Moderator
}

enum PostType {
  REGULAR
  CODE_QUERY
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}
